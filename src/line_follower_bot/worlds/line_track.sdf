<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- BRIGHT LIGHTING -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- WHITE FLOOR -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- CLOSED RACETRACK LOOP -->
    <model name="track_sec1">
      <static>true</static>
      <pose>1.5 0 0.001 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.0 0.12 0.002</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
    </model>

    <model name="track_sec2">
      <static>true</static>
      <pose>3.0 1.5 0.001 0 0 1.5708</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.0 0.12 0.002</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
    </model>

    <model name="track_sec3">
      <static>true</static>
      <pose>1.5 3.0 0.001 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.0 0.12 0.002</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
    </model>

    <model name="track_sec4">
      <static>true</static>
      <pose>0.0 1.5 0.001 0 0 1.5708</pose>
      <link name="l"><visual name="v"><geometry><box><size>3.0 0.12 0.002</size></box></geometry><material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material></visual></link>
    </model>

    <!-- START LINE (RED) -->
    <model name="start_line">
      <static>true</static>
      <pose>0.5 0 0.002 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.1 0.4 0.003</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>